{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "marketly-web": {
      "root": "client/",
      "framework": "nextjs"
    },
    "marketly-api": {
      "root": "server/",
      "framework": "express",
      "entrypoint": "src/app.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "marketly-api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "marketly-web" }
    }
  ]
}
