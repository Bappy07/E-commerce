# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Production (Render + Vercel) — set these in the Render dashboard, never in a committed .env file:
# NODE_ENV=production
# BETTER_AUTH_URL=https://your-marketly-api.onrender.com
# CLIENT_URL=https://your-marketly-app.vercel.app
# CORS_ORIGIN=https://your-marketly-app.vercel.app
# ALLOW_VERCEL_PREVIEWS=false

# MongoDB Atlas (paste your real URI here in .env)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/marketly?retryWrites=true&w=majority
DB_NAME=marketly

# Better Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Cloudinary (sellers cannot upload images until these are set)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SSLCommerz sandbox — add real sandbox credentials later. Never commit them.
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true

# Marketplace configuration
COMMISSION_PERCENT=10
FLAT_SHIPPING_FEE=60
FREE_SHIPPING_OVER=5000

# Seed demo accounts (change in production)
SEED_ADMIN_EMAIL=admin@marketly.test
SEED_ADMIN_PASSWORD=Admin@12345
SEED_SELLER_EMAIL=seller@marketly.test
SEED_SELLER_PASSWORD=Seller@12345
SEED_BUYER_EMAIL=buyer@marketly.test
SEED_BUYER_PASSWORD=Buyer@12345
